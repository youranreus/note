# ---- Web ----
VITE_API_BASE_URL=${VITE_API_BASE_URL}
# Browser redirect target for the SSO authorize page.

# ---- API ----
NODE_ENV=development
PORT=3001
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:5173

# Existing external MySQL instance
DATABASE_URL=mysql://root:password@127.0.0.1:3306/note

# Cookie / session
COOKIE_NAME=sid
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# OIDC integration
OIDC_ISSUER=https://sf.imouto.tech/oidc
OIDC_CLIENT_ID=your-client-id
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
SSO_MOCK_ENABLED=true
SSO_MOCK_TICKET_PREFIX=mock:
